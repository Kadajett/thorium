{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yougotserved.dev/schemas/thorium-web-v1.json",
  "title": "Thorium web-v1 Game Package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "version",
    "displayName",
    "summary",
    "description",
    "runtime",
    "displays",
    "players",
    "multiplayer",
    "controls",
    "capabilities",
    "budgets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 140 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sdkCompatibility", "entrypoints", "files"],
      "properties": {
        "kind": { "const": "web-v1" },
        "sdkCompatibility": { "type": "string", "pattern": "^\\^?\\d+\\.\\d+\\.\\d+$" },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main", "companion"],
          "properties": {
            "main": { "$ref": "#/$defs/mainEntrypoint" },
            "companion": { "$ref": "#/$defs/companionEntrypoint" }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packagePath" }
        }
      }
    },
    "displays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredSurfaces", "supportsSingleSurfaceFallback", "main", "companion"],
      "properties": {
        "requiredSurfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["main", "companion"] }
        },
        "supportsSingleSurfaceFallback": { "type": "boolean" },
        "main": { "$ref": "#/$defs/screen" },
        "companion": { "$ref": "#/$defs/screen" }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSlots", "maxSlots", "maxLocalSlots", "sameAccountMultipleSlots"],
      "properties": {
        "minSlots": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxSlots": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxLocalSlots": { "type": "integer", "minimum": 1, "maximum": 16 },
        "sameAccountMultipleSlots": { "type": "boolean" },
        "defaultLocalSeatPlan": {
          "type": "object", "additionalProperties": false, "required": ["main", "companion"],
          "properties": {
            "main": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 15 } },
            "companion": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 15 } }
          }
        }
      }
    },
    "multiplayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online", "roomName", "protocol"],
      "properties": {
        "online": { "type": "boolean" },
        "requiresOnline": { "type": "boolean" },
        "roomName": { "const": "game_session" },
        "protocol": { "const": "thorium-game-channel-v1" }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["button", "axis"] }
        }
      }
    },
    "controllerBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bindings"],
      "properties": {
        "schema": { "const": 1 },
        "bindings": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "input", "control"],
                "properties": {
                  "kind": { "const": "button" },
                  "input": { "enum": ["south", "east", "west", "north", "dpad-up", "dpad-down", "dpad-left", "dpad-right", "left-shoulder", "right-shoulder", "left-stick", "right-stick", "start", "select"] },
                  "control": { "$ref": "#/$defs/controlId" }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "input", "control"],
                "properties": {
                  "kind": { "const": "axis" },
                  "input": { "$ref": "#/$defs/controllerAxis" },
                  "control": { "$ref": "#/$defs/controlId" }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "input", "direction", "control"],
                "properties": {
                  "kind": { "const": "axis-button" },
                  "input": { "$ref": "#/$defs/controllerAxis" },
                  "direction": { "enum": [-1, 1] },
                  "control": { "$ref": "#/$defs/controlId" }
                }
              }
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["same-device-peer", "colyseus-session", "local-save-v1"] }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPackageBytes", "maxFileCount", "maxLocalPeerMessageBytes"],
      "properties": {
        "maxPackageBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "maxFileCount": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "maxLocalPeerMessageBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    }
  },
  "$defs": {
    "controlId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "controllerAxis": { "enum": ["left-x", "left-y", "right-x", "right-y", "left-trigger", "right-trigger"] },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
    },
    "mainEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "purpose": { "const": "primary-gameplay" }
      }
    },
    "companionEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "purpose": { "const": "companion-controls" }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalWidth", "logicalHeight", "maximumDevicePixelRatio"],
      "properties": {
        "logicalWidth": { "type": "integer", "minimum": 160, "maximum": 4096 },
        "logicalHeight": { "type": "integer", "minimum": 160, "maximum": 4096 },
        "maximumDevicePixelRatio": { "type": "number", "minimum": 1, "maximum": 3 }
      }
    }
  }
}
